# home.nix
# Generated by nix-config-collector on {{ .ScannedAt.Format "2006-01-02 15:04:05" }}
{ config, pkgs, lib, ... }:
{
  home.username = "{{ .Username }}";
  home.homeDirectory = "/Users/{{ .Username }}";
  home.stateVersion = "23.11";

  # User packages
  home.packages = with pkgs; [
    {{- range .NixPackages }}
    {{ .NixName }}
    {{- end }}
  ];

  {{- if .IsZsh }}
  programs.zsh = {
    enable = true;
  };
  {{- end }}

  {{- if .IsBash }}
  programs.bash = {
    enable = true;
  };
  {{- end }}

  {{- if .IsFish }}
  programs.fish = {
    enable = true;
  };
  {{- end }}

  {{- if .GitConfig }}
  programs.git = {
    enable = true;
    {{- if .GitUserName }}
    userName = "{{ .GitUserName }}";
    {{- end }}
    {{- if .GitUserEmail }}
    userEmail = "{{ .GitUserEmail }}";
    {{- end }}
  };
  {{- end }}

  programs.home-manager.enable = true;
}
