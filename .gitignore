# Wails build — ignore compiled frontend artifacts but keep the placeholder
# that satisfies //go:embed all:frontend/dist during Go builds/tests.
# Note: negation only works when the directory itself is not excluded,
# so we ignore the contents (dist/*) rather than the directory (dist/).
frontend/dist/*
!frontend/dist/.gitkeep
frontend/node_modules/

# Go
vendor/

# Scan output (don't commit)
scan.json
*.scan.json
