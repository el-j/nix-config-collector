# darwin-configuration.nix
# Generated by nix-config-collector on {{ .ScannedAt.Format "2006-01-02 15:04:05" }}
# Hostname: {{ .Hostname }}
{ config, pkgs, lib, ... }:
{
  # Nix configuration
  nix.settings.experimental-features = [ "nix-command" "flakes" ];
  nix.settings.trusted-users = [ "root" "@admin" ];

  # System packages (mapped from Homebrew formulae)
  environment.systemPackages = with pkgs; [
    {{- range .NixPackages }}
    {{ .NixName }}
    {{- end }}
  ];

  # Homebrew configuration
  homebrew = {
    enable = true;
    onActivation = {
      autoUpdate = true;
      cleanup = "zap";
    };
    {{- if .BrewFormulae }}
    brews = [
      {{- range .BrewFormulae }}
      "{{ .Name }}"
      {{- end }}
    ];
    {{- end }}
    {{- if .BrewCasks }}
    casks = [
      {{- range .BrewCasks }}
      "{{ .Name }}"
      {{- end }}
    ];
    {{- end }}
    {{- if .MASApps }}
    masApps = {
      {{- range .MASApps }}
      "{{ .Name }}" = 0; # TODO: add App Store ID
      {{- end }}
    };
    {{- end }}
  };

  # System preferences
  system.defaults = {
    dock = {
      {{- range .DockPrefs }}
      {{ .Key }} = {{ .NixValue }};
      {{- end }}
    };
    finder = {
      {{- range .FinderPrefs }}
      {{ .Key }} = {{ .NixValue }};
      {{- end }}
    };
    NSGlobalDomain = {
      {{- range .GlobalPrefs }}
      {{ .Key }} = {{ .NixValue }};
      {{- end }}
    };
  };

  # macOS system settings
  system.stateVersion = 4;
  services.nix-daemon.enable = true;
  programs.nix-index.enable = true;
}
